{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "vite.config.ts",
    "vitrine/releaseSummaryPlugin.ts",
    "vitrine/src/changelog/parseChangelog.ts",
    "vitrine/src/changelog/releaseHighlights.ts",
    "vitrine/src/changelog/releaseSummary.ts"
  ]
}
