# Configuration locale de CanopUI — copier vers .env (jamais commité).

# ── Service ───────────────────────────────────────────────
# Port du serveur de la vitrine CanopUI en dev, pour information : il est fixé dans
# vitrine/vite.config.ts et cette variable n'est lue par aucun code.
PORT=61000

# Username Buttondown de la newsletter bêta de la vitrine. À poser dans vitrine/.env :
# Vite lit les variables depuis la racine de la vitrine. Vide = canopui.
VITE_BUTTONDOWN_USERNAME=
