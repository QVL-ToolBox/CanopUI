{
  "name": "@canop/ui",
  "version": "1.3.4",
  "type": "module",
  "description": "CanopUI - design system QVL-Studio, librairie de composants React (wrapper MUI). Fork de CH-UI-Library v0.7.0 (QVL-CustHome)",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.qvl-project.com/"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "import": "./dist/map.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc -b && npm run vitrine:typecheck && vite build",
    "prepare": "npm run build",
    "vitrine": "vite serve vitrine",
    "vitrine:typecheck": "tsc -p vitrine/tsconfig.json",
    "vitrine:build": "npm run vitrine:typecheck && vite build vitrine",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/material": "^9.0.0",
    "framer-motion": "^13.0.0",
    "maplibre-gl": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/js": "^9.30.0",
    "@mui/material": "^9.4.0",
    "@svg-maps/france.departments": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "framer-motion": "^13.2.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "maplibre-gl": "^6.6.0",
    "prettier": "^3.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.3.7",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
